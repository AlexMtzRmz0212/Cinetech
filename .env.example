# Notion: create an internal integration at https://www.notion.so/profile/integrations
# and share your movie database with it (… menu > Connections).
NOTION_TOKEN=
NOTION_DATABASE_ID=

# TMDb: API Read Access Token (v4) from https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# OMDb (optional, adds IMDb rating): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Letterboxd public username (optional, for RSS sync)
LETTERBOXD_USERNAME=

# Trakt (optional): create an app at https://trakt.tv/oauth/applications and copy the Client ID.
# Your Trakt profile must be public.
TRAKT_CLIENT_ID=
TRAKT_USERNAME=

# Password gate for the whole app + secret used to sign the session cookie
APP_PASSWORD=
SESSION_SECRET=
